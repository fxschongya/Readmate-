rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  match /assignments/{id} {
   allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
   allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid
     && request.resource.data.studentUid is string
     && request.resource.data.studentUid.size() >= 20
     && request.resource.data.title is string && request.resource.data.passage is string
     && request.resource.data.questions is list;
   allow update, delete: if signedIn() && resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == resource.data.teacherUid && request.resource.data.studentUid == resource.data.studentUid;
  }
  match /submissions/{id} {
   allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || resource.data.teacherUid == request.auth.uid);
   allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid
     && request.resource.data.teacherUid is string
     && request.resource.data.assignmentId is string
     && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.studentUid == request.auth.uid
     && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid;
   allow update, delete: if false;
  }
 }
}
